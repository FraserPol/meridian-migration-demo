    "@ai-sdk/gateway": "^4.0.47",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.36.4",
    "jose": "^5.9.6",
    "next": "^16.3.0",
    "postgres": "^3.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
