# ---------------------------------------------------------------------------
# Local / demo mode (what you need to run this repo on your laptop)
# ---------------------------------------------------------------------------

# Points at the docker-compose Postgres (or a real AWS RDS instance's demo
# schema). When this is set, lib/vault.ts short-circuits Vault entirely and
# uses this connection string directly. This is the documented "local-dev
# fallback" described in solution-architecture.md Section 3 — it exists
# so the demo runs without a live HCP Vault cluster in front of you.
DATABASE_URL=postgres://meridian:meridian@localhost:5432/meridian

# Session cookie signing secret (any random 32+ char string for demo purposes)
AUTH_SECRET=change-me-to-a-random-32-char-secret-before-deploying

# ---------------------------------------------------------------------------
# AI Gateway (Migration Copilot)
# ---------------------------------------------------------------------------

# Only needed for LOCAL development. When this app is deployed on Vercel,
# AI Gateway authenticates automatically using the project's Vercel OIDC
# token (VERCEL_OIDC_TOKEN) — no key required, nothing to rotate or leak.
# Locally there's no Vercel OIDC token, so either:
#   1. Run `vercel env pull` to get a short-lived local OIDC token, or
#   2. Set an AI Gateway API key here (from your Vercel dashboard -> AI Gateway)
AI_GATEWAY_API_KEY=

# ---------------------------------------------------------------------------
# Production mode (set these instead of DATABASE_URL once Vault + Secure
# Compute are provisioned via infra/terraform — see infra/terraform/README.md)
# ---------------------------------------------------------------------------

# HCP Vault cluster address, e.g. https://<cluster-id>.vault.<region>.hcp.dev:8200
VAULT_ADDR=

# Vault namespace every request must send as X-Vault-Namespace. HCP Vault
# Dedicated reserves the root namespace for HashiCorp's own platform
# operations (not customer-accessible) — "admin" is where
# infra/terraform/modules/vault-config actually creates everything.
VAULT_NAMESPACE=admin

# Name of the JWT auth mount + role that trusts Vercel's OIDC issuer
# (created by infra/terraform/modules/vault-config)
VAULT_JWT_AUTH_ROLE=vercel-app

# Name of the database secrets engine role that issues short-lived,
# TTL-bound Postgres credentials scoped to this app
VAULT_DB_ROLE=meridian-app-role

# Host/port/dbname for the AWS RDS instance Vault issues credentials against
# (Vault manages the *credentials*, not the connection target)
PGHOST=
PGPORT=5432
PGDATABASE=meridian
